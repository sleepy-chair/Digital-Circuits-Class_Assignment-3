  <vhdl appearance="logisim_evolution" name="RS_Latch">--library and package
LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.std_logic_arith.all;
USE ieee.std_logic_unsigned.all;


--entity (input&amp;output)
ENTITY RS_Latch IS
	PORT (
		r,s			:IN  std_logic;                    
		q,nq			:OUT std_logic
	);
END RS_Latch;

--architecture
ARCHITECTURE bhv OF RS_Latch IS
BEGIN
	process(s,r)
	begin
		if (s = '1') then
			nq &lt;= '0';
			if (r = '1') then
				q &lt;= '0';
			else
				q &lt;= '1';
			end if;
		elsif (r = '1') then
			q &lt;= '0';
			nq &lt;= '1';
		end if;
	end process;
END ARCHITECTURE bhv;</vhdl>
  <vhdl appearance="logisim_evolution" name="D_Latch">--library and package
LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.std_logic_arith.all;
USE ieee.std_logic_unsigned.all;

--entity (input&amp;output)
ENTITY D_Latch IS
	PORT (
		d,en			:IN  std_logic;                    
		q			:OUT std_logic
	);
END D_Latch;

--architecture
ARCHITECTURE bhv OF D_Latch IS
BEGIN
	process(d,en)
	begin
		if (en = '1') then
			q &lt;= d;
		end if;
	end process;
END ARCHITECTURE bhv;</vhdl>
  <vhdl appearance="logisim_evolution" name="D_FlipFlop">--library and package
LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.std_logic_arith.all;
USE ieee.std_logic_unsigned.all;

--entity (input&amp;output)
ENTITY D_FlipFlop IS
	PORT (
		d,clk		:IN  std_logic;                    
		q			:OUT std_logic
	);
END D_FlipFlop;

--architecture
ARCHITECTURE bhv OF D_FlipFlop IS
BEGIN
	process(d,clk)
	begin
		if rising_edge(clk) then
			q &lt;= d;
		end if;
	end process;
END ARCHITECTURE bhv;</vhdl>
  <vhdl appearance="logisim_evolution" name="JK_FlipFlop">--library and package
LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.std_logic_arith.all;
USE ieee.std_logic_unsigned.all;

--entity (input&amp;output)
ENTITY JK_FlipFlop IS
	PORT (
		j,k,clk		:IN  std_logic;                    
		q			:OUT std_logic
	);
END JK_FlipFlop;

--architecture
ARCHITECTURE bhv OF JK_FlipFlop IS
	Signal q_internal : std_logic := '0';
BEGIN
	q &lt;= q_internal;
	process(j,k,clk)
	begin
		if rising_edge(clk) then
			if (j='0' and k='1') then
				q_internal &lt;= '0';
			elsif (j='1' and k='0') then
				q_internal &lt;= '1';
			elsif (j='1' and k='1') then
				q_internal &lt;= not q_internal;
			end if;
		end if;
	end process;
END ARCHITECTURE bhv;
</vhdl>
  <vhdl appearance="logisim_evolution" name="D_FlipFlop2">--library and package
LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.std_logic_arith.all;
USE ieee.std_logic_unsigned.all;

--entity (input&amp;output)
ENTITY D_FlipFlop2 IS
	PORT (
		d,clk,clr,set	:IN  std_logic;                    
		q			:OUT std_logic
	);
END D_FlipFlop2;

--architecture
ARCHITECTURE bhv OF D_FlipFlop2 IS
BEGIN
	process(d,clk,clr,set)
	begin
		if clr = '1' then
			q &lt;= '0';
		elsif set = '1' then
			q &lt;= '1';
		elsif rising_edge(clk) then
			q &lt;= d;
		end if;
	end process;
END ARCHITECTURE bhv;</vhdl>
</project>
